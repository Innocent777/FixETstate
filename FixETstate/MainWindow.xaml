<Window x:Class="FixETstate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteReset"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔧 RemoteReset"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Device maintenance and safe reset"
                       FontSize="16"
                       Foreground="#6B7280"
                       Margin="0,5,0,25"/>
        </StackPanel>

        <!-- MAIN CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="30">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DEVICE -->
                <TextBlock Grid.Row="0"
                           Text="Registered Device"
                           FontSize="14"
                           Foreground="#6B7280"/>

                <TextBlock Grid.Row="1"
                           Text="MY-WINDOWS-PC"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           Margin="0,5,0,15"/>

                <!-- STATUS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">

                    <Ellipse Width="12"
                             Height="12"
                             Fill="#22C55E"
                             Margin="0,0,8,0"/>

                    <TextBlock Text="Device connected"
                               FontSize="15"
                               Foreground="#374151"/>
                </StackPanel>

                <!-- INFORMATION -->
                <Border Grid.Row="3"
                        Background="#F9FAFB"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,25,0,25">

                    <StackPanel>

                        <TextBlock Text="Current status"
                                   FontSize="14"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="StatusText"
                                   Text="No maintenance request"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,5,0,20"/>

                        <TextBlock Text="A reset will restore only the settings selected by the administrator. Personal files such as documents, photos and videos will not be deleted."
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Foreground="#4B5563"/>

                    </StackPanel>

                </Border>

                <!-- BUTTON -->
                <Button Grid.Row="4"
                        x:Name="TestRequestButton"
                        Content="Test Reset Request"
                        Height="50"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="TestRequestButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>
