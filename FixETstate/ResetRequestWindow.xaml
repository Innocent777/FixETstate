<Window x:Class="FixETstate.ResetRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maintenance Request"
        Height="430"
        Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Border Margin="20"
            Background="White"
            CornerRadius="15"
            Padding="30">

        <StackPanel>

            <TextBlock Text="🔧 SYSTEM MAINTENANCE"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="A reset request has been received for this device."
                       FontSize="17"
                       Foreground="#4B5563"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,20,0,15"/>

            <Border Background="#EFF6FF"
                    CornerRadius="10"
                    Padding="15">

                <TextBlock Text="Your personal files will NOT be deleted. Documents, photos, videos and other user files will remain."
                           FontSize="15"
                           Foreground="#1E40AF"
                           TextWrapping="Wrap"/>

            </Border>

            <TextBlock Text="The following approved settings may be restored to their default configuration:"
                       FontSize="15"
                       Foreground="#374151"
                       Margin="0,20,0,5"/>

            <TextBlock Text="✓ Application settings&#10;✓ Network configuration&#10;✓ RemoteReset configuration"
                       FontSize="15"
                       Foreground="#374151"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">

                <Button Content="ACCEPT &amp; RESTART"
                        Width="210"
                        Height="45"
                        Margin="5"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="AcceptButton_Click"/>

                <Button Content="DECLINE"
                        Width="140"
                        Height="45"
                        Margin="5"
                        Background="#E5E7EB"
                        Foreground="#111827"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="DeclineButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Border>

</Window>